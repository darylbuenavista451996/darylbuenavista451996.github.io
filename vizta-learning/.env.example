# Vizta Learning — environment variables
# Copy this file to .env and fill in the values. Never commit .env.

# --- Supabase (Project Settings -> API) ---
# The project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Public anon key — safe for the browser (used by the Next.js app later).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Bypasses RLS. Used by the seed script and
# by server-side app code. NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Student login (built in Step 2) ---
# Class-code -> grade mapping lives here, not in code, so codes can change
# each school year. Format: CODE:CLASS pairs, comma separated.
CLASS_CODES=MEDIA9:G9,MEDIA10:G10

# Secret used to sign the student session cookie (any long random string).
SESSION_SECRET=
